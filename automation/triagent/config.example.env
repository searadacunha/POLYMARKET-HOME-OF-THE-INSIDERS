# Copy to ~/.config/triagent/config.env (install.sh does it). Secrets go in secrets.env (mode 600), never here.
RUN_MODE=dryrun
# subscription = Claude Code with your claude.ai login (--safe-mode); api = ANTHROPIC_API_KEY (--bare)
CLAUDE_AUTH=subscription
CLAUDE_MODEL=sonnet
CLAUDE_MAX_MISSIONS_DAY=6
CLAUDE_MAX_USD_PER_MISSION=3
# Reviewer/planner. codex_cli = official Codex CLI signed in with your ChatGPT plan (`codex login`), no API key;
# it is not the ChatGPT browser. api = OPENAI_API_KEY, billed per token. chatgpt_gui is blocked (see README).
OPENAI_MODE=codex_cli
OPENAI_MODEL=gpt-6.1-sol
OPENAI_MAX_USD_DAY=3
# xai_api (XAI_API_KEY + X Search) | grok_cli (Grok Build CLI, `grok login`) | bot (Grok Bot webhook + public HTTPS callback)
GROK_MODE=xai_api
XAI_MODEL=grok-4.7
XAI_MAX_USD_DAY=3
ALERT_MIN_USDC=5000
ALERT_MIN_FLAGS=3
ALERT_MISSIONS_DAY=3
DISK_MIN_FREE_GB=13.5
HTTP_PORT=8790
# Investigation center: daily digest time and notifications (also editable in the page's Settings)
DAILY_REPORT_TIME=19:00
DAILY_REPORT_TZ=Europe/Lisbon
NOTIFY_ENABLED=1
NOTIFY_MAX_DAY=8
# Historical campaign (`triagent campaign start`): leads per GPT triage, and its draft PRs (never main, never merged)
CAMPAIGN_TRIAGE_BATCH=12
PUBLISH_ENABLED=1
PUBLISH_MAX_OPEN=3
# Grok cells per day = GROK_MAX_MISSIONS_DAY (in grok_cli mode only the call count applies, not the CLI's $ estimate)
GROK_MAX_MISSIONS_DAY=6
