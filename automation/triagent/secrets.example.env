# ~/.config/triagent/secrets.env, chmod 600. Read only by the supervisor; never sent to a model or logged.
OPENAI_API_KEY=
XAI_API_KEY=
# only with CLAUDE_AUTH=api
ANTHROPIC_API_KEY=
# only with GROK_MODE=bot
GROK_BOT_WEBHOOK_KEY=
GROK_CALLBACK_SECRET=
# BROKER_TOKEN, N8N_WAKE_TOKEN and UI_TOKEN (dashboard commands; `triagent ui-token` copies it) are generated
# by install.sh and appended here.
